{
  "name": "@dudousxd/nestjs-authz",
  "version": "0.6.7",
  "description": "NestJS authorization — Laravel-style Gates & Policies, @Can guard, resource resolver (zero DB).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-authz.git",
    "directory": "packages/core"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/authz",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-authz/issues"
  },
  "keywords": [
    "nestjs",
    "authorization",
    "authz",
    "gate",
    "policy",
    "acl",
    "rbac",
    "tanstack-intent"
  ],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./store-kit": {
      "types": "./dist/store-kit.d.ts",
      "import": "./dist/store-kit.js",
      "default": "./dist/store-kit.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md", "skills"],
  "dependencies": {
    "@dudousxd/nestjs-diagnostics": "0.7.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-context": ">=0.1.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.13"
  },
  "peerDependenciesMeta": {
    "@dudousxd/nestjs-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "12.0.1",
    "@tanstack/intent": "0.4.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/supertest": "7.2.1",
    "express": "4.22.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
