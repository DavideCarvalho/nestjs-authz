{
  "name": "@dudousxd/nestjs-authz-inertia",
  "version": "2.0.0",
  "description": "Inertia.js integration for @dudousxd/nestjs-authz — share a user's abilities as props so client `can()` checks need no network request.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-authz.git",
    "directory": "packages/inertia"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/authz",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-authz/issues"
  },
  "keywords": ["nestjs", "authorization", "authz", "inertia", "inertia.js", "abilities", "can"],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dudousxd/nestjs-authz-client": "workspace:^"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-authz": ">=0.10.0",
    "@dudousxd/nestjs-context": ">=0.1.0",
    "@dudousxd/nestjs-inertia": ">=1.0.0",
    "@nestjs/authorization": "^0.1.3",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": ">=0.1.13"
  },
  "peerDependenciesMeta": {
    "@dudousxd/nestjs-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-authz": "workspace:^",
    "@dudousxd/nestjs-inertia": "1.8.2",
    "@nestjs/authorization": "0.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.19.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
