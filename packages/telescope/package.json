{
  "name": "@dudousxd/nestjs-authz-telescope",
  "version": "0.0.0",
  "description": "nestjs-telescope extension for @dudousxd/nestjs-authz — records every authorization decision (ability, allow/deny, reason) in the Telescope dashboard so 403s are debuggable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-authz.git",
    "directory": "packages/telescope"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-authz": ">=0.2.0",
    "@dudousxd/nestjs-telescope": "^1.8.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-authz": "workspace:^",
    "@dudousxd/nestjs-telescope": "1.8.0",
    "@dudousxd/nestjs-telescope-testing": "1.8.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "nestjs",
    "authorization",
    "authz",
    "telescope",
    "observability",
    "watcher",
    "extension"
  ]
}
