{
  "name": "@dudousxd/nestjs-authz-testing",
  "version": "0.1.1",
  "description": "Test helpers for @dudousxd/nestjs-authz on @nestjs/authorization: a real Gate on a Nest testing module, expectCan/expectCannot, in-memory RBAC fakes, route requirement inspection.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-authz.git",
    "directory": "packages/testing"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/authz",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-authz/issues"
  },
  "keywords": ["nestjs", "authorization", "authz", "testing", "gate", "policy", "fixtures"],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-authz": ">=0.9.0 <0.10.0",
    "@nestjs/authorization": "^0.1.3",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "reflect-metadata": ">=0.1.13"
  },
  "devDependencies": {
    "@dudousxd/nestjs-authz": "workspace:^",
    "@nestjs/authorization": "0.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/node": "22.20.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
