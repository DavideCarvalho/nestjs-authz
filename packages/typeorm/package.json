{
  "name": "@dudousxd/nestjs-authz-typeorm",
  "version": "2.0.0",
  "description": "TypeORM RBAC persistence for @dudousxd/nestjs-authz — roles, permissions, and a Gate seam (zero connection ownership).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-authz.git",
    "directory": "packages/typeorm"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/authz",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-authz/issues"
  },
  "keywords": ["nestjs", "authorization", "authz", "rbac", "roles", "permissions", "typeorm"],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "test": "vitest run --passWithNoTests",
    "test:db": "pnpm test:db:pg && pnpm test:db:mysql",
    "test:db:pg": "AUTHZ_TEST_DIALECT=postgres vitest run --config vitest.db.config.ts",
    "test:db:mysql": "AUTHZ_TEST_DIALECT=mysql vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-authz": ">=0.10.0",
    "@nestjs/authorization": "^0.1.3",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": ">=0.1.13",
    "typeorm": "^0.3.0",
    "@nestjs/typeorm": ">=12.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-authz": "workspace:^",
    "@nestjs/authorization": "0.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@nestjs/typeorm": "12.0.3",
    "@testcontainers/mysql": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "mysql2": "3.24.4",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sqlite3": "5.1.7",
    "supertest": "7.2.2",
    "typeorm": "0.3.31",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependenciesMeta": {
    "@nestjs/typeorm": {
      "optional": true
    }
  }
}
